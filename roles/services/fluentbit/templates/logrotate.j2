# Fluent Bit - logrotate

{{ fluentbit_dir.logs }}/*.log {
  rotate -1
  daily
  missingok
  notifempty
  maxage 210
  nocreate
{% if not(fluentbit_iconfig.enabled_hot_reload | default(true)) %}
  copytruncate
{% endif %}
  compress
  delaycompress
  dateext
  dateformat -%Y%m%d
  sharedscripts
{% if fluentbit_iconfig.enabled_hot_reload | default(true) %}

  postrotate
    pid_target="$(pidof fluent-bit)"

    if [ -n "$pid_target" ]; then
      kill -HUP "$pid_target"
    fi
  endscript
{% endif %}
}

