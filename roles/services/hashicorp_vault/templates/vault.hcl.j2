# HashiCorp Vault configuration file

# Core
pid_file      = "{{ hashicorp_vault_dir.run }}/vault.pid"
cluster_name  = "{{ hashicorp_vault_config.name }}"
disable_mlock = true

default_max_request_duration = "60s"
default_lease_ttl            = "30d"
max_lease_ttl                = "90d"

api_addr     = "{{ hc_vault_iconfig.advertise.api_addr }}"
cluster_addr = "{{ hc_vault_iconfig.advertise.cluster_addr }}"
ui           = true

# Listener 
listener "unix" {
  address     = "{{ hashicorp_vault_dir.run }}/vault.sock"
  socket_mode = "640"
}

listener "tcp" {
  address     = "0.0.0.0:8200"
  tls_disable = true
}

# Logging
log_level = "{{ hc_vault_iconfig.log_level | default('info') }}"
log_file  = "{{ hashicorp_vault_dir.logs }}/vault.log"

# Storage
storage "raft" {
  path = "{{ hashicorp_vault_dir.data }}"
}

# Security

## User Lockout
user_lockout "all" {
  lockout_threshold     = "5"
  lockout_counter_reset = "15m"
  lockout_duration      = "30m"
}

